diff --git a/Dockerfile.portmaster b/Dockerfile.portmaster
new file mode 100644
index 00000000..17f120a1
--- /dev/null
+++ b/Dockerfile.portmaster
@@ -0,0 +1,33 @@
+FROM debian:buster
+
+# Buster keeps the build userspace below ArkOS's Ubuntu 19.10 / glibc 2.30
+# baseline while still providing SDL2_mixer 2.0.4, which is enough now that the
+# PortMaster build no longer hard-requires the 2.6.x-only music position APIs.
+
+RUN sed -i 's|deb.debian.org/debian|archive.debian.org/debian|g' /etc/apt/sources.list && \
+    sed -i 's|deb.debian.org/debian-security|archive.debian.org/debian-security|g' /etc/apt/sources.list && \
+    sed -i '/buster-updates/d' /etc/apt/sources.list && \
+    printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99buster-archive && \
+    dpkg --add-architecture arm64 && \
+    apt-get update && \
+    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+      build-essential \
+      cmake \
+      make \
+      pkg-config \
+      git \
+      ca-certificates \
+      gcc-aarch64-linux-gnu \
+      g++-aarch64-linux-gnu \
+      libc6-dev-arm64-cross \
+      libsdl2-dev:arm64 \
+      libsdl2-image-dev:arm64 \
+      libsdl2-mixer-dev:arm64 \
+      libsdl2-ttf-dev:arm64 \
+      libsdl2-gfx-dev:arm64 \
+      libmpg123-dev:arm64 && \
+    rm -rf /var/lib/apt/lists/*
+
+WORKDIR /workspace
+ENV CC=aarch64-linux-gnu-gcc
+ENV CXX=aarch64-linux-gnu-g++
